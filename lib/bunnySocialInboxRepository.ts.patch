+function conversationFromRow(row: any): any {
+  const conv = parseJson(row.data_json);
+  return {
+    ...conv,
+    _id: String(conv._id || row.document_id),
+    conversationKey: conv.conversationKey || row.conversation_key,
+    platform: conv.platform || row.platform,
+    accountId: conv.accountId || row.account_id,
+    participantId: conv.participantId || row.participant_id,
+    participantName: conv.participantName || row.participant_name,
+    participantUsername: conv.participantUsername || row.participant_username,
+    status: conv.status || row.status,
+    unreadCount: Number(row.unread_count || 0),
+    lastMessage: conv.lastMessage || row.last_message,
+    lastMessageAt: conv.lastMessageAt || row.last_message_at,
+    lastMessageDirection: conv.lastMessageDirection || row.last_message_direction,
+    isBlocked: Number(row.is_blocked || 0) === 1,
+  };
+}
+
+export async function listBunnySocialConversations(input: { platform: string; scopeType: string; scopeKey: string; limit?: number; search?: string }): Promise<any[]> {
+  await ensureBunnySocialInboxSchema();
+  const clauses: string[] = ['platform = ?', 'account_scope_type = ?', 'account_scope_key = ?'];
+  const args: any[] = [input.platform, input.scopeType, input.scopeKey];
+  
+  if (input.search) {
+    clauses.push('(participant_name LIKE ? OR participant_username LIKE ? OR participant_id LIKE ? OR last_message LIKE ?)');
+    const safeSearch = `%${input.search}%`;
+    args.push(safeSearch, safeSearch, safeSearch, safeSearch);
+  }
+
+  const result = await bunnyExecute({
+    sql: `SELECT * FROM social_inbox_conversations_sql WHERE ${clauses.join(' AND ')} ORDER BY last_message_at DESC LIMIT ?`,
+    args: [...args, input.limit || 200],
+  });
+  return result.rows.map(conversationFromRow);
+}
+
+function messageFromRow(row: any): any {
+  const msg = parseJson(row.data_json);
+  return {
+    ...msg,
+    _id: String(msg._id || row.document_id),
+    conversationId: msg.conversationId || row.conversation_id,
+    externalMessageId: msg.externalMessageId || row.external_message_id,
+    senderId: msg.senderId || row.sender_id,
+    recipientId: msg.recipientId || row.recipient_id,
+    direction: msg.direction || row.direction,
+    messageType: msg.messageType || row.message_type,
+    isRead: Number(row.is_read || 0) === 1,
+    sentAt: msg.sentAt || row.sent_at,
+  };
+}
+
+export async function listBunnySocialMessages(conversationId: string, limit: number = 50): Promise<any[]> {
+  await ensureBunnySocialInboxSchema();
+  const result = await bunnyExecute({
+    sql: `SELECT * FROM social_inbox_messages_sql WHERE conversation_id = ? ORDER BY sent_at DESC LIMIT ?`,
+    args: [conversationId, limit],
+  });
+  return result.rows.map(messageFromRow).reverse();
+}
