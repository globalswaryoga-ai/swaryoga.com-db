+export async function deduplicateAndUpsertMetaMessage(message: Record<string, any>) {
+  await initBunnyMetaWhatsAppSchema();
+  
+  // If it's a large message (e.g., bulk template), extract the payload
+  const isBulk = message.isBulk || message.metadata?.isBulk;
+  const payloadToHash = message.messageContent || message.media?.url;
+  
+  if (isBulk && payloadToHash) {
+    const payload = { 
+      messageContent: message.messageContent, 
+      media: message.media 
+    };
+    const hash = crypto.createHash('sha256').update(JSON.stringify(payload)).digest('hex');
+    
+    // Store payload exactly once
+    await bunnyExecute({
+      sql: `INSERT OR IGNORE INTO meta_template_payloads_sql (template_hash, payload_json, created_at) VALUES (?, ?, ?)`,
+      args: [hash, JSON.stringify(payload), new Date().toISOString()]
+    });
+    
+    // Remove payload from the message itself to save space
+    delete message.messageContent;
+    delete message.media;
+    message.templateHash = hash;
+  }
+  
+  return upsertBunnyMetaMessage(message);
+}
