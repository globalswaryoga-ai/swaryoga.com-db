# =====================================================
# OPTION C - BACKUP SYSTEM ENVIRONMENT VARIABLES
# =====================================================
# Copy this to your .env.local file and fill in values

# =====================================================
# BUNNY CDN CONFIGURATION
# =====================================================
# Get these from Bunny Dashboard → Account → API Keys

BUNNY_STORAGE_KEY=your_bunny_storage_api_key_here
BUNNY_STORAGE_ZONE=swaryoga-storage
BUNNY_REGION=sg  # sg (Singapore), de (Germany), la (Los Angeles), etc.

# =====================================================
# BACKUP SCHEDULE
# =====================================================

BACKUP_TIME=02:00  # UTC time for daily backup (24-hour format)
RETENTION_DAYS=30  # Keep HOT data in MongoDB for N days
ARCHIVE_DAYS=180   # Archive to COLD tier after N days

# =====================================================
# ENCRYPTION
# =====================================================

ENCRYPTION_ENABLED=true
# Generate a 32-byte hex key: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# =====================================================
# NOTIFICATIONS (Email)
# =====================================================

SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@swaryoga.com
BACKUP_ALERT_EMAIL=admin@swaryoga.com

# =====================================================
# NOTIFICATIONS (Slack) - Optional
# =====================================================

# Get from Slack → Create Incoming Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =====================================================
# BACKUP API SECURITY
# =====================================================

# Generate a secure key: openssl rand -hex 32
BACKUP_API_KEY=your_backup_api_key_here

# =====================================================
# LOGGING
# =====================================================

LOG_DIR=.logs/backup
LOG_LEVEL=info  # debug, info, warn, error

# =====================================================
# OPTIONAL: DATABASE BACKUP
# =====================================================

# If you want to backup to multiple locations
BACKUP_TO_AWS_S3=false
AWS_S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret

# =====================================================
# MONITORING
# =====================================================

# Send heartbeat to monitoring service
MONITORING_ENABLED=false
MONITORING_URL=https://your-monitoring.com/api/ping
