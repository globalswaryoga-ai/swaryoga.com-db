{
  "name": "swaryoga-whatsapp-bridge",
  "version": "2.0.0",
  "description": "Production-grade WhatsApp Web bridge with auto-healing for Swar Yoga CRM",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "health-check": "node health-check.js",
    "monitor": "bash monitor.sh",
    "logs": "pm2 logs wa-bridge",
    "restart": "pm2 restart wa-bridge",
    "stop": "pm2 stop wa-bridge",
    "test": "node test-bridge.js"
  },
  "keywords": [
    "whatsapp",
    "web",
    "bridge",
    "qr",
    "messaging",
    "auto-healing"
  ],
  "author": "Swar Yoga",
  "license": "ISC",
  "dependencies": {
    "whatsapp-web.js": "^1.25.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "dotenv": "^16.3.1",
    "aws-sdk": "^2.1502.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "socket.io": "^4.6.1",
    "pm2": "^5.3.0",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
