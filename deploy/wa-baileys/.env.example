# Swar Yoga WhatsApp Bridge - Environment Variables
# Copy this file to .env and fill in your values

# Port for the bridge HTTP server
PORT=3333

# Secret for authenticating CRM requests
BRIDGE_SECRET=swar-bridge-secret-2024

# Your Vercel app URL (where incoming messages are forwarded)
WEBHOOK_URL=https://swaryoga.com

# MongoDB connection string (same as your main app)
# Used to persist WhatsApp auth state across restarts
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# CRM database name (where auth state is stored)
MONGODB_CRM_DB_NAME=swaryoga_admin_crm

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=warn
