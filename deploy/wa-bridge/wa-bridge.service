[Unit]
Description=WhatsApp QR Bridge - Persistent Service
Documentation=https://github.com/globalswaryoga-ai/swaryoga.com-db
After=network-online.target docker.service
Wants=network-online.target
BindsTo=docker.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
Restart=always
RestartSec=10
StartLimitAction=reboot

# Core service command
ExecStart=/opt/wa-bridge/start-service.sh

# Pre-start checks
ExecStartPre=/opt/wa-bridge/pre-start-check.sh

# On failure
OnFailure=wa-bridge-alert@%n.service

# Resource limits
MemoryLimit=2G
MemoryHigh=1500M
CPUQuota=70%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wa-bridge

# User and permissions
User=ubuntu
Group=ubuntu
UMask=0022

# Environment
Environment="PORT=3333"
Environment="NODE_ENV=production"
Environment="WHATSAPP_WEB_BRIDGE_SECRET=swar-bridge-secret-2024"
Environment="SESSION_DIR=/home/ubuntu/.wwebjs_auth"

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/ubuntu/.wwebjs_auth

[Install]
WantedBy=multi-user.target
