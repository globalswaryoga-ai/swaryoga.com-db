# ============================================================================
# SADHANA SCHEDULER - ENVIRONMENT VARIABLES
# ============================================================================

# ZOOM CREDENTIALS (Required for bot to join meetings)
# ============================================================================

# Option 1: User-Level Token (RECOMMENDED - easier to set up)
# Get from: https://marketplace.zoom.us/develop/apps
# Create OAuth app → Install → Get user access token
ZOOM_USER_ACCESS_TOKEN=your_user_access_token_here
ZOOM_USER_EMAIL=your_zoom_email@example.com

# Option 2: Service Account Credentials (Fallback if Option 1 doesn't work)
# If user token doesn't work, use these instead
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Bot Account Credentials (Alternative naming)
ZOOM_BOT_ACCOUNT_ID=
ZOOM_BOT_CLIENT_ID=
ZOOM_BOT_CLIENT_SECRET=
ZOOM_BOT_JID=your_bot_user_id@xmpp.zoom.us

# ============================================================================
# SADHANA SCHEDULER SETTINGS
# ============================================================================

# Cron security token (protect scheduler endpoint)
CRON_SECRET=super-secret-cron-key-change-this

# Default timezone for schedules (India Standard Time)
# Change only if your Sadhana is in different timezone
TIMEZONE=Asia/Kolkata

# ============================================================================
# VERCEL CRON (if deploying to Vercel)
# ============================================================================
# Add to vercel.json:
# {
#   "crons": [{
#     "path": "/api/admin/crm/sadhana-scheduler/check",
#     "schedule": "* * * * *"
#   }]
# }

# ============================================================================
# EXTERNAL CRON SERVICE
# ============================================================================
# Use any cron service (EasyCron, AWS Lambda, etc.) to call:
# GET https://your-domain/api/admin/crm/sadhana-scheduler/check
# Header: x-cron-secret: super-secret-cron-key-change-this
