{
  "version": 2,
  "framework": "nextjs",
  "functions": {
    "app/api/admin/media/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/crm/templates/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/crm/sales/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/crm/leads/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/settings/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/workshops/videos/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/crm/broadcast-runs/run/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/crm/scheduled-messages/run/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/crm/chatbot-actions/run/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/crm/inactive-cleanup/run/route.ts": {
      "maxDuration": 60
    },
    "app/api/whatsapp/qr/webhook/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/backup/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/export/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/weekly-sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/qr-broadcast-processor-v2/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/qr-queue-processor/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/admin/crm/chatbot-actions/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/crm/scheduled-messages/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/crm/broadcast-runs/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/crm/sadhana-scheduler/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/crm/group-merge-scheduler/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/crm-site/capacity",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/admin/crm/inactive-cleanup/run",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/export",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/weekly-sync",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/qr-broadcast-processor-v2",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/qr-queue-processor",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "env": {
    "VERCEL_DEPLOYMENT": "true"
  }
}
