{
  "name": "swar-yoga-web",
  "version": "1.0.0",
  "description": "Swar Yoga e-commerce website",
  "scripts": {
    "dev": "next dev",
    "dev:no-check": "PORT=3000 next dev --port 3000",
    "dev:reset": "node scripts/dev-reset-3000.mjs",
    "health-check": "node scripts/health-check.js",
    "diagnose-bridge": "node scripts/diagnose-bridge.js",
    "repair-bridge": "bash scripts/repair-bridge.sh",
    "bridge:emergency-restart": "bash scripts/emergency-restart-bridge.sh",
    "bridge:diagnostics": "bash scripts/bridge-diagnostics.sh",
    "bridge:quick-check": "node scripts/quick-bridge-check.js",
    "bridge:emergency-cleanup": "bash scripts/emergency-cleanup.sh",
    "cleanup": "bash scripts/auto-cleanup.sh",
    "cleanup:full": "bash scripts/auto-cleanup.sh",
    "disk": "node scripts/disk-manager.js",
    "disk:watch": "node scripts/disk-manager.js --watch --interval=30",
    "disk:aggressive": "node scripts/disk-manager.js --tier=aggressive",
    "disk:emergency": "node scripts/disk-manager.js --tier=emergency",
    "disk:dry-run": "node scripts/disk-manager.js --dry-run",
    "monitor-disk": "node scripts/disk-monitor.js",
    "monitor-disk:daemon": "node scripts/disk-monitor.js -- --daemon",
    "ssh-key": "node scripts/ssh-key-manager.js",
    "ssh-key:test": "node scripts/ssh-key-manager.js test",
    "ssh-key:info": "node scripts/ssh-key-manager.js info",
    "ssh-key:config": "node scripts/ssh-key-manager.js config",
    "build": "node scripts/auto-cleanup.js && next build",
    "vercel-build": "node scripts/auto-cleanup.js && next build",
    "vercel-start": "next start",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop swar-yoga-web",
    "pm2:restart": "pm2 restart swar-yoga-web",
    "pm2:delete": "pm2 delete swar-yoga-web",
    "pm2:logs": "pm2 logs swar-yoga-web",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "test:load": "node scripts/test-domain-load.js",
    "test:load:domain": "BASE_URL=https://app.swaryoga.com node scripts/test-domain-load.js",
    "domain:show": "node scripts/domain-config.js show",
    "domain:set": "node scripts/domain-config.js set",
    "domain:list": "node scripts/domain-config.js list"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@distube/ytdl-core": "^4.16.12",
    "@react-pdf/renderer": "^4.3.1",
    "@supabase/supabase-js": "^2.88.0",
    "@types/pdfkit": "^0.17.4",
    "@vercel/blob": "^2.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.1",
    "canvg": "^4.0.3",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.3.1",
    "dotenv": "^16.4.0",
    "emoji-picker-react": "^4.16.1",
    "express": "^5.2.1",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^10.5.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.12.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.560.0",
    "mongodb": "^6.5.0",
    "mongoose": "^7.7.0",
    "next": "^14.1.0",
    "nodemailer": "^8.0.1",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.2",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-rnd": "^10.5.2",
    "react-router-dom": "^7.11.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.7.0",
    "suncalc": "^1.9.0",
    "tailwindcss": "^3.4.0",
    "uuid": "^9.0.1",
    "whatsapp-web.js": "^1.34.2",
    "ws": "^8.18.3"
