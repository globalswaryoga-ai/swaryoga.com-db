{
  "name": "swar-yoga-web",
  "version": "1.0.0",
  "description": "Swar Yoga e-commerce website",
  "scripts": {
    "dev": "node scripts/dev-with-status.js",
    "dev:no-check": "PORT=3000 next dev --port 3000",
    "dev:no-ec2": "PORT=3000 next dev --port 3000",
    "dev:reset": "node scripts/dev-reset-3000.mjs",
    "ec2:status": "node scripts/ec2-status.js",
    "health-check": "node scripts/health-check.js",
    "monitor-bridge": "node scripts/monitor-bridge-health.js",
    "setup-ec2-recovery": "bash scripts/setup-ec2-auto-recovery.sh",
    "build": "next build",
    "vercel-build": "next build",
    "vercel-start": "next start",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop swar-yoga-web",
    "pm2:restart": "pm2 restart swar-yoga-web",
    "pm2:delete": "pm2 delete swar-yoga-web",
    "pm2:logs": "pm2 logs swar-yoga-web",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "bridge": "cd services/whatsapp-web && node index.js",
    "bridge:smoke": "node scripts/whatsapp-bridge-smoke.js",
    "bridge:pm2:start": "pm2 start services/whatsapp-web/ecosystem.config.cjs",
    "bridge:pm2:restart": "pm2 restart swaryoga-whatsapp-bridge",
    "bridge:pm2:logs": "pm2 logs swaryoga-whatsapp-bridge",
    "test:load": "node scripts/test-domain-load.js",
    "test:load:domain": "BASE_URL=https://app.swaryoga.com node scripts/test-domain-load.js",
    "domain:show": "node scripts/domain-config.js show",
    "domain:set": "node scripts/domain-config.js set",
    "domain:list": "node scripts/domain-config.js list"
  },
