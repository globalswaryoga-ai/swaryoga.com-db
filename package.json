    "@testing-library/jest-dom": "^6.9.1",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.27",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.8",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.17",
    "cspell": "^8.17.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.0",
    "happy-dom": "^20.0.11",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
